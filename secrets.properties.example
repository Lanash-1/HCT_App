# Template only — copy to secrets.properties (gitignored) and fill in real values.
# Documents the per-environment Catalyst config keys the app will need; wiring these into
# the build (BuildConfig fields) happens alongside the actual Catalyst SDK integration.
# See docs/TECH_STACK.md §9b and §Environments.

# Dev Catalyst project
CATALYST_DEV_PROJECT_ID=
CATALYST_DEV_PROJECT_DOMAIN=
CATALYST_DEV_API_KEY=

# Prod Catalyst project (create before first release build)
CATALYST_PROD_PROJECT_ID=
CATALYST_PROD_PROJECT_DOMAIN=
CATALYST_PROD_API_KEY=
